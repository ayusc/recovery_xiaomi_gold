import /init.mitee.rc
import /init.vibrator.rc
import /init.hals.rc

# Set SELinux to Permissive
on early-init
    write /sys/fs/selinux/enforce 0

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller musb-hdrc
    setprop vendor.usb.controller musb-hdrc
    setprop sys.usb.ffs.aio_compat 1
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    setprop crypto.ready 1

on fs
    install_keyring
    mkdir /mnt/vendor/persist 0755 system system
    mkdir /persist 0755 system system
    mount_all /system/etc/persist.fstab --early
    restorecon_recursive /mnt/vendor/persist
    mkdir /mnt/vendor/persist/data 0755 system system
    mount none /mnt/vendor/persist /persist bind
 
# We need vold early for metadata encryption
on early-fs
    start vold

on late-fs
    # Mount RW partitions which need run fsck
    mount_all /first_stage_ramdisk/fstab.mt6833 --late

on post-fs
    # Support A/B feature for EMMC and UFS boot region
    wait /dev/block/mmcblk0boot0 2
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/by-name/preloader_b

    # Support A/B feature for combo emmc and ufs OTA update
    symlink /dev/block/by-name/preloader_a /dev/block/by-name/preloader_emmc_a
    symlink /dev/block/by-name/preloader_b /dev/block/by-name/preloader_emmc_b
    symlink /dev/block/by-name/preloader_a /dev/block/by-name/preloader_ufs_a
    symlink /dev/block/by-name/preloader_b /dev/block/by-name/preloader_ufs_b

    symlink /dev/block/mapper/pl_a /dev/block/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/by-name/preloader_raw_b

    start vendor.boot-default
    start adbd

# Services
service keymint-mitee /vendor/bin/hw/android.hardware.security.keymint@3.0-service.mitee
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service vendor.gatekeeper-mitee /vendor/bin/hw/android.hardware.gatekeeper-service.mitee
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service load-ts-drv /system/bin/sh /system/bin/load-ts-drv.sh
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service load-wifi-drv /system/bin/sh /system/bin/load-wifi-drv.sh
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service wmt_loader /vendor/bin/wmt_loader
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service wmt_launcher /vendor/bin/wmt_launcher -p /vendor/firmware/ -o 1
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

on property:vendor.wmt.driver.loaded=1
    start wmt_loader
    start wmt_launcher

on property:vendor.connsys.driver.ready=yes
    insmod /lib/modules/wmt_chrdev_wifi.ko
    insmod /lib/modules/wlan_drv_gen4m_6833.ko

#####

on property:crypto.ready=1
    start keymint-mitee

on property:hwservicemanager.ready=true
    start keymint-mitee
    start vendor.gatekeeper-mitee

on property:ro.crypto.state=unsupported
    stop keymint-mitee
    stop vendor.gatekeeper-mitee
    stop tee-supplicant
    
on property:ro.crypto.state=unencrypted
    stop keymint-mitee
    stop vendor.gatekeeper-mitee
    stop tee-supplicant

on property:twrp.decrypt.done=true
    stop keymint-mitee
    stop vendor.gatekeeper-mitee
    stop tee-supplicant

on property:crypto.ready=0
    stop keymint-mitee
    stop vendor.gatekeeper-mitee
    stop tee-supplicant

on boot
    chmod 0666 /sys/devices/platform/11e01000.i2c/i2c-5/5-0034/mt6360-led.3.auto/leds/mt6360_flash_ch1/brightness
    chown system system /sys/devices/platform/11e01000.i2c/i2c-5/5-0034/mt6360-led.3.auto/leds/mt6360_flash_ch1/brightness
    chmod 0666 /sys/class/leds/mt6360_flash_ch1/brightness
    chown system system /sys/class/leds/mt6360_flash_ch1/brightness
    chmod 0666 /dev/flashlight
    chown system camera /dev/flashlight
    start vendor.health-default
    start load-ts-drv
    start load-wifi-drv
    start wmt_loader
    start wmt_launcher
    start adbd
    setprop sys.usb.config none
    setprop sys.usb.config adb
