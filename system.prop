ro.vendor.mtk_tee_gp_support=1
ro.vendor.mtk_mitee_support=1
ro.vendor.mtk_microtrust_tee_support=1

# USB & ADB
ro.adb.secure=0
ro.secure=0
ro.debuggable=1
persist.sys.usb.config=adb
sys.usb.controller=musb-hdrc
vendor.usb.controller=musb-hdrc
ro.recovery.usb.vid=18D1
ro.recovery.usb.adb.pid=D001
ro.recovery.usb.fastboot.pid=4EE0

# Display / Touch
ro.vendor.touchfeature.type=2
ro.vendor.idle_fps=60
ro.vendor.display.aod_monitor_default_fps=60
ro.vendor.display.is_standard_mode=true

# Wi-Fi
ro.hardware.wlan.dbs=0
ro.vendor.wlan.gen=gen4m_6833
ro.vendor.wlan.chrdev=wmt_chrdev_wifi
ro.vendor.wlan.standalone.log=y
